export component Tooltip inherits PopupWindow {
    in property <string> text;
    in property <bool> open: false;
    in property <length> anchor-y: 0px;

    x: 0px;
    y: root.anchor-y - root.height - 4px;
    close-policy: PopupClosePolicy.no-auto-close;

    changed open => {
        if (root.open) {
            root.show();
        } else {
            root.close();
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #111827;
        border-radius: 6px;
    }

    label := Text {
        x: 8px;
        y: 7px;
        width: parent.width - 16px;
        text: root.text;
        wrap: word-wrap;
        font-size: 12px;
        color: #ffffff;
    }

    height: label.preferred-height + 14px;
}
