import { ScrollView } from "std-widgets.slint";
import { Tokens } from "../theme/tokens.slint";

export component Tooltip inherits Rectangle {
    in property <string> text;
    in property <bool> open: false;
    in property <length> anchor-y: 0px;
    in property <length> max-bottom: 176px;

    visible: open;
    y: min(max(4px, root.anchor-y - root.height - 4px), root.max-bottom - root.height);
    background: Tokens.color-floating-surface;
    border-color: Tokens.color-floating-border;
    border-width: 1px;
    border-radius: Tokens.radius-sm;
    drop-shadow-blur: Tokens.shadow-e3-blur;
    drop-shadow-offset-y: Tokens.shadow-e3-offset-y;
    drop-shadow-color: Tokens.shadow-e3-color;

    scroll := ScrollView {
        x: 8px;
        y: 7px;
        width: parent.width - 16px;
        height: parent.height - 14px;
        viewport-height: label.preferred-height;
        label := Text {
            width: parent.width;
            text: root.text;
            wrap: word-wrap;
            font-size: 12px;
            color: Tokens.color-card-foreground;
        }
    }

    height: min(label.preferred-height + 14px, 160px);
}
